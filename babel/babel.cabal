cabal-version: 3.0
name:          babel
version:       0.1.0.0
synopsis:      Validator for the Cookbook of Babel recipe dataset
build-type:    Simple

common shared
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  -- No -Wunused-packages: it misreports base and relude as unused under mixins.
  ghc-options:        -Wall -Wcompat

  -- relude replaces the default Prelude everywhere.
  build-depends:
    , base    >=4.18 && <5
    , relude  >=1.2  && <1.3

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude),
    relude

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Babel.Check
    Babel.Codec
    Babel.Diagnostic
    Babel.Format
    Babel.Load
    Babel.Model
    Babel.Model.Common
    Babel.Model.Constants
    Babel.Model.Dataset
    Babel.Model.Id
    Babel.Model.Ingredient
    Babel.Model.Recipe
    Babel.Model.Registry
    Babel.Model.Source
    Babel.Model.Technique
    Babel.Spoilage
    Babel.Validate

  build-depends:
    , aeson        >=2.2 && <2.3
    , autodocodec  >=0.5 && <0.6
    , bytestring
    , containers
    , directory
    , filepath
    , scientific
    , text
    , vector

executable babel
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , babel
    , optparse-applicative  >=0.18 && <0.19
    , text

test-suite babel-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:
    Fixture
    Gen

  build-depends:
    , aeson
    , autodocodec
    , babel
    , bytestring
    , containers
    , directory
    , filepath
    , hedgehog        >=1.4 && <1.6
    , tasty           >=1.4 && <1.6
    , tasty-hedgehog  >=1.4 && <1.5
    , tasty-hunit
    , temporary
    , text
    , vector
