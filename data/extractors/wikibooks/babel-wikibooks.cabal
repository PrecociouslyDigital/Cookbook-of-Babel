cabal-version: 3.0
name:          babel-wikibooks
version:       0.1.0.0
synopsis:      Extracts the Wikibooks Cookbook into the babel dataset
build-type:    Simple

-- Same language settings as babel/babel.cabal, which .hlint.yaml mirrors.
common shared
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:        -Wall -Wcompat
  build-depends:
    , base    >=4.18 && <5
    , relude  >=1.2  && <1.3

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude),
    relude

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Wikibooks.Dump
    Wikibooks.Page
    Wikibooks.Quantity
    Wikibooks.Wikitext

  build-depends:
    , babel
    , conduit
    , containers
    , megaparsec
    , text
    , xml-conduit
    , xml-types

test-suite babel-wikibooks-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , babel
    , babel-wikibooks
    , hedgehog
    , tasty
    , tasty-hedgehog
    , text
