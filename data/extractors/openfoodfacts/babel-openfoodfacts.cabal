cabal-version: 3.0
name:          babel-openfoodfacts
version:       0.1.0.0
synopsis:
  Extracts OpenFoodFacts nutrition and piece masses into the babel dataset

build-type:    Simple

-- Same language settings as babel/babel.cabal, which .hlint.yaml mirrors.
common shared
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:        -Wall -Wcompat
  build-depends:
    , base    >=4.18 && <5
    , relude  >=1.2  && <1.3

  mixins:
    base hiding (Prelude),
    relude (Relude as Prelude),
    relude

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    OpenFoodFacts.Aggregate
    OpenFoodFacts.Emit
    OpenFoodFacts.Match
    OpenFoodFacts.Taxonomy

  build-depends:
    , babel
    , containers
    , text

executable babel-openfoodfacts
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  build-depends:
    , aeson
    , autodocodec
    , babel
    , babel-openfoodfacts
    , bytestring
    , containers
    , directory
    , filepath
    , optparse-applicative
    , text

test-suite babel-openfoodfacts-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , babel
    , babel-openfoodfacts
    , containers
    , hedgehog
    , tasty
    , tasty-hedgehog
    , tasty-hunit
    , text
