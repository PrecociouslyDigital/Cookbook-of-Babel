{
  "id": "nutritional_yeast.pasteurize",
  "source": "cookbook_of_babel",
  "technique": "heat",
  "inputs": {
    "of": [
      {
        "ingredient": "yeast_culture",
        "amount": {
          "qty": 2150,
          "unit": "g"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "deactivated_yeast",
      "amount": {
        "qty": 2150,
        "unit": "g"
      }
    }
