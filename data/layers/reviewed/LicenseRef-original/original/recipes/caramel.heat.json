{
  "id": "caramel.heat",
  "source": "cookbook_of_babel",
  "technique": "heat",
  "inputs": {
    "of": [
      {
        "ingredient": "white_sugar",
        "amount": {
          "qty": 200,
          "unit": "g"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "caramel",
      "amount": {
        "qty": 190,
        "unit": "g"
      }
    }
  ],
  "environment": {
    "temperatureC": 170,
    "medium": "pan_contact"
  },
  "end": {
    "by": "coreTemp",
    "coreTempC": 170
  },
  "stateNote": "sugar melted dry to an amber syrup",
  "issues": [
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "a little sugar caramelises onto the pan and is lost"
    }
  ]
}
