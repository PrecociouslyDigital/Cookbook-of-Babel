{
  "id": "mustard_seed.dry_pods",
  "source": "cookbook_of_babel",
  "technique": "dry",
  "inputs": {
    "of": [
      {
        "ingredient": "mustard_pods",
        "amount": {
          "qty": 50,
          "unit": "g"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "dried_mustard_pods",
      "amount": {
        "qty": 15,
        "unit": "g"
      }
    }
  ],
  "end": {
    "by": "time",
    "duration": {
      "qty": 4,
      "unit": "d"
    },
    "sensitivity": {
      "refTempC": 20,
      "q10": 2
    }
  },
  "stateNote": "pods are left to air-dry until brown and brittle; they lose about two-thirds of their weight as water",
  "issues": [
    {
      "field": "end",
      "kind": "estimate",
      "note": "drying time varies widely with ambient humidity"
    },
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "small batch keeps the drying rack's whole-item quantization exact; water leaves as steam"
    }
  ]
}
