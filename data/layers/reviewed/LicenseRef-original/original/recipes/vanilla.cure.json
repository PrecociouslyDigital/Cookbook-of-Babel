{
  "id": "vanilla.cure",
  "source": "cookbook_of_babel",
  "technique": "cure",
  "inputs": {
    "of": [
      {
        "ingredient": "vanilla_curing_batch",
        "amount": {
          "qty": 100,
          "unit": "g"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "vanilla",
      "amount": {
        "qty": 42,
        "unit": "g"
      }
    }
  ],
  "end": {
    "by": "time",
    "duration": {
      "qty": 30,
      "unit": "d"
    },
    "sensitivity": {
      "refTempC": 25,
      "q10": 2
    }
  },
  "stateNote": "green pods are blanched, sweated, and dried until dark and flexible; one batch fills the curing jar",
  "issues": [
    {
      "field": "end",
      "kind": "estimate",
      "note": "vanilla curing is a slow process; 30 days is a simplified estimate"
    },
    {
      "field": "inputs",
      "kind": "estimate",
      "note": "the batch is one curing jar charge of prepared pods, sized so the cure lands on whole items"
    }
  ]
}
