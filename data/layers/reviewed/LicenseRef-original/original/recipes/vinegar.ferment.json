          "unit": "ml"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "vinegar",
      "amount": {
        "qty": 900,
        "unit": "ml"
      }
    }
  ],
  "end": {
    "by": "time",
    "duration": {
      "qty": 14,
      "unit": "d"
    },
    "sensitivity": {
      "refTempC": 25,
      "q10": 2
    }
  },
  "stateNote": "cider is left open to the air so acetobacter turn alcohol into acetic acid",
  "issues": [
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "about 10% of the volume is lost as evaporation and CO2"
    }
  ]
