{
  "id": "limeade.press",
  "source": "cookbook_of_babel",
  "technique": "press",
  "inputs": {
    "of": [
      {
        "ingredient": "lime",
        "amount": {
          "qty": 300,
          "unit": "g"
        }
      },
      {
        "ingredient": "lemon",
        "amount": {
          "qty": 100,
          "unit": "g"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "citrus_juice",
      "amount": {
        "qty": 200,
        "unit": "ml"
      }
    }
  ],
  "end": {
    "by": "time",
    "duration": {
      "qty": 5,
      "unit": "min"
    },
    "sensitivity": {
      "refTempC": 20,
      "q10": 1
    }
  },
  "stateNote": "rolled, halved and pressed",
  "issues": [
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "about half the citrus weight is juice; pulp and peel are discarded"
    }
  ]
}
