      "unit": "min"
    }
  },
  "stateNote": "bacon fried until crisp, the fat poured off and strained",
  "environment": {
    "temperatureC": 150,
    "medium": "pan_contact"
  },
  "issues": [
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "depends on how fatty the bacon is"
    }
  ]
