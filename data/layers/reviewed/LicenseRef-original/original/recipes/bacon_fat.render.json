{
  "id": "bacon_fat.render",
  "source": "cookbook_of_babel",
  "technique": "heat",
  "inputs": {
    "of": [
      {
        "ingredient": "bacon",
        "amount": {
          "qty": 500,
          "unit": "g"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "bacon_fat",
      "amount": {
        "qty": 200,
        "unit": "g"
      }
    }
