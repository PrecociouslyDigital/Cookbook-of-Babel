{
  "id": "fruit_salt.mix",
  "source": "cookbook_of_babel",
  "technique": "mix",
  "inputs": {
    "of": [
      {
        "ingredient": "baking_soda",
        "amount": {
          "qty": 100,
          "unit": "g"
        }
      },
      {
        "ingredient": "lemon",
        "amount": {
          "qty": 30,
          "unit": "ml"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "fruit_salt",
      "amount": {
        "qty": 200,
        "unit": "g"
      }
    }
  ],
  "end": {
    "by": "time",
    "duration": {
      "qty": 5,
      "unit": "min"
    },
    "sensitivity": {
      "refTempC": 20,
      "q10": 1
    }
  },
  "stateNote": "soda and citric acid blended dry",
  "issues": [
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "blended dry; tartaric acid and fruit flavoring are usually folded in too"
    },
    {
      "field": "inputs",
      "kind": "estimate",
      "note": "lemon juice's citric acid stands in for the pure acid"
    }
  ]
}
