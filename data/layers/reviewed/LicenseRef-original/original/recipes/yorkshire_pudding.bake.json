{
  "id": "yorkshire_pudding.bake",
  "source": "cookbook_of_babel",
  "technique": "bake",
  "inputs": {
    "of": [
      {
        "ingredient": "yorkshire_batter_batch",
        "amount": {
          "qty": 480,
          "unit": "g"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "yorkshire_pudding",
      "amount": {
        "qty": 420,
        "unit": "g"
      }
    }
  ],
  "environment": {
    "temperatureC": 220,
    "medium": "oven_air"
  },
  "end": {
    "by": "coreTemp",
    "coreTempC": 90
  },
  "stateNote": "the rested batch of batter poured over hot fat and baked until it rises and sets",
  "issues": [
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "about 7% mass lost as steam"
    },
    {
      "field": "inputs",
      "kind": "estimate",
      "note": "the hot fat is folded into the batter"
    }
  ]
}
