{
  "id": "mustard_seed.thresh",
  "source": "cookbook_of_babel",
  "technique": "cut",
  "inputs": {
    "of": [
      {
        "ingredient": "dried_mustard_pods",
        "amount": {
          "qty": 30,
          "unit": "g"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "mustard_seed",
      "amount": {
        "qty": 25,
        "unit": "g"
      }
    }
  ],
  "end": {
    "by": "time",
    "duration": {
      "qty": 5,
      "unit": "min"
    },
    "sensitivity": {
      "refTempC": 20,
      "q10": 1
    }
  },
  "stateNote": "brittle pods are crushed or rubbed to release the round seeds",
  "issues": [
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "hulling losses are estimated at about a fifth"
    }
  ]
}
