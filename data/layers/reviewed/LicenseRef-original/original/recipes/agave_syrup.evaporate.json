{
  "id": "agave_syrup.evaporate",
  "source": "cookbook_of_babel",
  "technique": "evaporate",
  "inputs": {
    "of": [
      {
        "ingredient": "agave_juice",
        "amount": {
          "qty": 1000,
          "unit": "ml"
        }
      }
    ]
  },
  "outputs": [
    {
      "ingredient": "agave_syrup",
      "amount": {
        "qty": 300,
        "unit": "g"
      }
    }
  ],
  "environment": {
    "temperatureC": 90,
    "medium": "simmering_water"
  },
  "end": {
    "by": "time",
    "duration": {
      "qty": 6,
      "unit": "h"
    },
    "sensitivity": {
      "refTempC": 20,
      "q10": 1
    }
  },
  "stateNote": "the juice reduced slowly to a thick syrup",
  "issues": [
    {
      "field": "outputs",
      "kind": "estimate",
      "note": "reduced to roughly a third, as a thin honey-coloured syrup"
    }
  ]
}
